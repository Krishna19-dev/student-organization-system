# ─────────────────────────────────────────────────────────────
#  .env.example — Safe template to share with your team
#  Copy this file to .env and fill in your actual values.
#  This file IS committed to git (no secrets here).
# ─────────────────────────────────────────────────────────────

# PostgreSQL Database URL (Prisma format)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/skyline_db?schema=public"

# Next.js App
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="replace-with-a-secure-random-32-char-secret-key"

# Node Environment
NODE_ENV="development"
